--- a/certify/docker-compose/docker-compose.yaml
+++ b/certify/docker-compose/docker-compose.yaml
@@ -7,6 +7,8 @@ services:
       - POSTGRES_PASSWORD=postgres
     volumes:
       - ./certify_init.sql:/docker-entrypoint-initdb.d/certify_init.sql
+      # keep the database (and with it Certify's key records) across 'docker compose down'

# Copy to .env and fill in your own Google OAuth 2.0 Web application credentials.
# Console: https://console.cloud.google.com  ->  APIs & Services  ->  Credentials
#   Authorised JavaScript origin : http://localhost:8099
#   Authorised redirect URI      : http://localhost:8099/v1/mimoto/oauth2/callback/google
# Add your own Google account under OAuth consent screen -> Test users.
# .env is gitignored. Never commit real credentials.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
